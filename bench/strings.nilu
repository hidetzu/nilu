local words = {}
for i = 1, 20000 do words[i] = string.format("w%05d", i) end
local text = table.concat(words, " ")
local upper = string.upper(text)
local count = 0
for w in string.gmatch(text, "w%d+") do count = count + 1 end
local replaced, n = string.gsub(text, "(w)(%d)", "%2%1")
local found = 0
for i = 1, 20000, 7 do
  if string.find(text, words[i], 1, true) then found = found + 1 end
end
local bytes = 0
for i = 1, #text, 3 do bytes = bytes + string.byte(text, i) end
local parts = {}
for i = 1, 2000 do parts[i] = string.sub(upper, i * 7, i * 7 + 5) .. string.rep("-", i % 4) end
print(#text, count, n, found, bytes, #table.concat(parts), #replaced)
